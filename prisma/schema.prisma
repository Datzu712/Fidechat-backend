generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model channel {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  position    Int       @default(0)
  guild_id    String    @db.Uuid
  guild       guild     @relation(fields: [guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message     message[]

  @@index([guild_id], map: "idx_channel_guild_id")
}

model guild {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(100)
  icon_url    String?       @db.VarChar(500)
  is_public   Boolean?      @default(false)
  owner_id    String        @db.Uuid
  description String?       @db.VarChar(300)
  channel     channel[]
  user        user          @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guild_users guild_users[]
}

model guild_users {
  guild_id String @db.Uuid
  user_id  String @db.Uuid
  guild    guild  @relation(fields: [guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     user   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([guild_id, user_id])
  @@index([guild_id], map: "idx_guild_users_guild_id")
  @@index([user_id], map: "idx_guild_users_user_id")
}

model message {
  id         String   @id @db.Uuid
  content    String   @db.VarChar(2000)
  author_id  String   @db.Uuid
  channel_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user       user     @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  channel    channel  @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([channel_id], map: "idx_message_channel_id")
  @@index([created_at(sort: Desc)], map: "idx_message_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username    String        @db.VarChar(255)
  email       String        @db.VarChar(255)
  is_bot      Boolean       @default(false)
  avatar_url  String?       @db.VarChar(500)
  guild       guild[]
  guild_users guild_users[]
  message     message[]
}
